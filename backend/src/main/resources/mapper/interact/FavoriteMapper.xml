<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.storyworkshop.module.interact.mapper.FavoriteMapper">
    <insert id="insert" parameterType="com.example.storyworkshop.module.interact.entity.Favorite">INSERT INTO favorite (user_id, story_id) VALUES (#{userId},#{storyId})</insert>
    <delete id="delete">DELETE FROM favorite WHERE user_id=#{userId} AND story_id=#{storyId}</delete>
    <select id="select" resultType="com.example.storyworkshop.module.interact.entity.Favorite">SELECT fav_id,user_id,story_id,create_time FROM favorite WHERE user_id=#{userId} AND story_id=#{storyId} LIMIT 1</select>
</mapper>
