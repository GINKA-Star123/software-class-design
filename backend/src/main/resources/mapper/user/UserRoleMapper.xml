<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.storyworkshop.module.user.mapper.UserRoleMapper">

    <resultMap id="UserRoleResultMap" type="com.example.storyworkshop.module.user.entity.UserRole">
        <id property="userId" column="user_id"/>
        <id property="roleId" column="role_id"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <insert id="insert" parameterType="com.example.storyworkshop.module.user.entity.UserRole">
        INSERT INTO user_role (
            user_id,
            role_id
        )
        VALUES (
            #{userId},
            #{roleId}
        )
    </insert>

    <insert id="insertIgnore">
        INSERT IGNORE INTO user_role (
            user_id,
            role_id
        )
        VALUES (
            #{userId},
            #{roleId}
        )
    </insert>

    <delete id="deleteByUserIdAndRoleId">
        DELETE FROM user_role
        WHERE user_id = #{userId}
          AND role_id = #{roleId}
    </delete>

    <delete id="deleteByUserId">
        DELETE FROM user_role
        WHERE user_id = #{userId}
    </delete>

    <select id="selectByUserId" resultMap="UserRoleResultMap">
        SELECT
            user_id,
            role_id,
            create_time
        FROM user_role
        WHERE user_id = #{userId}
        ORDER BY role_id ASC
    </select>

</mapper>